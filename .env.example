PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DEMO_ACCOUNT_PASSWORD=replace-with-a-strong-demo-password
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection used by the application at runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/transitops?schema=public"
# Optional direct database connection fallback (may require IPv6; prefer session-pooler DATABASE_URL)
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Brevo HTTPS API (recommended for Render; when set, this takes priority over SMTP)
BREVO_API_KEY=

# SMTP fallback (for local mail catcher or hosts that permit outbound SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@transitops.com

# Razorpay Configuration (Optional: defaults to test demo key)
RAZORPAY_KEY_ID=rzp_test_transitops_demo
RAZORPAY_KEY_SECRET=secret_test_transitops_key
RAZORPAY_WEBHOOK_SECRET=configure-a-unique-webhook-secret