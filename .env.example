PORT=3000
NODE_ENV=development
JWT_SECRET=transitops-jwt-secure-secret-key-2026

# Database Connection (Default SQLite; change to Supabase/PostgreSQL when ready)
DATABASE_URL="file:./dev.db"
# DIRECT_URL is required when using Supabase/PostgreSQL with connection pooling
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# SMTP Configuration (Optional: defaults to local/mock transport if not set)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@transitops.com

# Razorpay Configuration (Optional: defaults to test demo key)
RAZORPAY_KEY_ID=rzp_test_transitops_demo
RAZORPAY_KEY_SECRET=secret_test_transitops_key
RAZORPAY_WEBHOOK_SECRET=transitops_webhook_secret_2026