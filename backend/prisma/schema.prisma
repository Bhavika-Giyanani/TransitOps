datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(uuid())
  tenantId          String
  email             String   @unique
  passwordHash      String
  fullName          String
  role              String   @default("fleet_manager")
  isDemoAccount     Boolean  @default(false)
  avatarUrl         String?
  driverId          String?
  contactNumber     String?
  licenseNumber     String?
  licenseCategory   String?
  licenseExpiryDate String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

model Vehicle {
  id                       String   @id @default(uuid())
  tenantId                 String
  registrationNumber       String
  name                     String
  model                    String
  type                     String
  maxCapacityKg            Float
  currentOdometerKm        Float
  acquisitionCost          Float?
  status                   String   @default("Available")
  region                   String   @default("West")
  revenueGenerated         Float?   @default(0)
  fuelEfficiencyKmPerLiter Float    @default(8.0)
  documents                String?  // JSON encoded string
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([tenantId])
}

model Driver {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  licenseNumber       String
  licenseCategory     String   @default("HGMV")
  licenseExpiryDate   String
  contactNumber       String
  email               String
  safetyScore         Float    @default(100)
  status              String   @default("Available")
  tripsCount          Int      @default(0)
  incidentHistoryCount Int     @default(0)
  totalTripsCompleted Int      @default(0)
  identityUserId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model Trip {
  id                String    @id @default(uuid())
  tenantId          String
  tripCode          String
  source            String
  destination       String
  vehicleId         String
  vehicleRegNumber  String
  vehicleName       String
  driverId          String
  driverName        String
  cargoWeightKg     Float
  plannedDistanceKm Float
  revenue           Float?    @default(0)
  status            String    @default("Draft")
  dispatchedAt      DateTime?
  completedAt       DateTime?
  finalOdometerKm   Float?
  fuelConsumedLiters Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}

model MaintenanceRecord {
  id               String    @id @default(uuid())
  tenantId         String
  vehicleId        String
  vehicleRegNumber String
  vehicleName      String
  serviceType      String
  description      String
  cost             Float
  date             String
  startDate        DateTime?
  completedDate    String?
  completedAt      DateTime?
  status           String    @default("Active")
  technicianNotes  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
}

model Expense {
  id              String   @id @default(uuid())
  tenantId        String
  vehicleId       String
  vehicleRegNumber String?
  vehicleName     String?
  tripId          String?
  type            String   @default("Other")
  category        String?
  amount          Float
  cost            Float?
  date            String
  expenseDate     String?
  liters          Float?
  fuelLiters      Float?
  odometerReading Float?
  description     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

model SubscriptionPlan {
  id          String @id
  name        String
  amountPaise Int
  currency    String @default("INR")
  termMonths  Int    @default(1)
  features    String // JSON string array
}

model PurchaseSession {
  id                 String   @id @default(uuid())
  purchaseSecret     String
  organizationName   String
  fullName           String
  email              String
  verificationCode   String
  emailVerified      Boolean  @default(false)
  planId             String?
  orderId            String?
  paymentId          String?
  paymentVerified    Boolean  @default(false)
  receiptEmailSent   Boolean  @default(false)
  setupEmailSent     Boolean  @default(false)
  setupCompleted     Boolean  @default(false)
  createdAt          DateTime @default(now())
}
