{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build API",
      "program": "${workspaceFolder}/backend/TransitOps.Api/bin/Debug/net10.0/TransitOps.Api.dll",
      "cwd": "${workspaceFolder}/backend/TransitOps.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "pattern": "Now listening on: (https?)://",
        "uriFormat": "%s://localhost:3000",
        "action": "openExternally"
      },
      "checkForDevCert": false
    },
    {
      "name": "Frontend (React)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "TransitOps (API + frontend)",
      "configurations": [
        "API (.NET)",
        "Frontend (React)"
      ],
      "stopAll": true
    }
  ]
}
